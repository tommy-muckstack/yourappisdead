{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/calendlyisdead",
      "destination": "https://calendlyisdead.vercel.app/calendlyisdead"
    },
    {
      "source": "/calendlyisdead/:path*",
      "destination": "https://calendlyisdead.vercel.app/calendlyisdead/:path*"
    },
    {
      "source": "/wisprflowisdead",
      "destination": "https://wisprflowisdead.vercel.app/wisprflowisdead"
    },
    {
      "source": "/wisprflowisdead/:path*",
      "destination": "https://wisprflowisdead.vercel.app/wisprflowisdead/:path*"
    },
    {
      "source": "/miroisdead",
      "destination": "https://miroisdead.vercel.app/miroisdead"
    },
    {
      "source": "/miroisdead/:path*",
      "destination": "https://miroisdead.vercel.app/miroisdead/:path*"
    },
    {
      "source": "/superhumanisdead",
      "destination": "https://superhumanisdead.vercel.app/superhumanisdead"
    },
    {
      "source": "/superhumanisdead/:path*",
      "destination": "https://superhumanisdead.vercel.app/superhumanisdead/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.yourappisdead.com"
        }
      ],
      "destination": "https://yourappisdead.com/:path*",
      "permanent": true
    }
  ]
}
